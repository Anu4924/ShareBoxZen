{
   "action": {
      "default_popup": "src/popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "https://chatgpt.com/*", "https://claude.ai/*" ]
   }, {
      "js": [ "genai-collector.js" ],
      "matches": [ "https://chatgpt.com/*", "https://claude.ai/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "genai-relay.js" ],
      "matches": [ "https://chatgpt.com/*", "https://claude.ai/*" ],
      "run_at": "document_start"
   } ],
   "description": "Transform unclear questions into expert prompts. Get better AI responses from ChatGPT and Claude with one click.",
   "host_permissions": [ "https://us-central1-metaprompt-e64e3.cloudfunctions.net/*", "https://identitytoolkit.googleapis.com/*" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "MetaPrompt - AI Prompt Engineer & Optimizer for ChatGPT & Claude",
   "permissions": [ "storage", "identity", "alarms" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.2.0",
   "web_accessible_resources": [ {
      "matches": [ "https://metaprompt.stayfreeapps.com/*" ],
      "resources": [ "src/onboarding.html" ]
   } ]
}
